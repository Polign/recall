# Defaults the first-boot script starts from. It writes the effective
# configuration to /etc/recall/recall.env, keeping any value already set there
# by the launch (Terraform or a startup script), and filling the
# rest from here and from instance metadata. Both services read that file:
# polign-server (the database) and recall (the memory server in front of it).
#
# POLIGN_STORE has no default on purpose. Recall never creates its own
# bucket, so a launch has to name one:
#   POLIGN_STORE=gcs://my-bucket/recall
# or set the instance metadata attribute  recall-store = gcs://my-bucket/recall

# The instance reaches its bucket as the attached service account, picked up
# as Application Default Credentials, so the image holds no keys. A bucket in
# another project needs no extra setup: grant this VM's service account
# roles/storage.objectAdmin on it directly.
#
# Optional: the project billed for the GCS requests. Empty is the VM's own.
GOOGLE_CLOUD_PROJECT=

# Client-side encryption: a keyring here makes every object ciphertext before
# it leaves the instance. Choose it before the first write. Generate one with
#   umask 077; printf '1=%s\n' "$(openssl rand -base64 32)" > /etc/recall/store.keys
#   chown root:polign /etc/recall/store.keys; chmod 0640 /etc/recall/store.keys
POLIGN_STORE_ENCRYPTION_KEY_FILE=

# Recall's address. This is the only port the instance serves; the database
# listens on localhost only and is reached through Recall. Every request needs
# a Recall key. Keep the firewall rule scoped to your VPC.
RECALL_LISTEN=:8080

# Search by meaning, with the model built into the image: no API key and no
# outbound call. To use a hosted embedder instead, set for example
#   RECALL_EMBED_MODEL=openai:text-embedding-3-small@512
#   OPENAI_API_KEY=sk-...
# Choose before the first write: memory written with one embedder is searched
# with that embedder. "lexical" is word search only.
RECALL_EMBED_MODEL=local:all-minilm-l6-v2

# Optional: a model that pulls statements out of free text passed to
# remember, as provider:model, with its API key, for example
#   RECALL_EXTRACT_MODEL=anthropic:claude-haiku-5-5
#   ANTHROPIC_API_KEY=...
RECALL_EXTRACT_MODEL=

# Local disk cache for the database under /var/cache/polign. Keep it below
# the root volume size.
POLIGN_DISK_CACHE_BYTES=10737418240

# Appended verbatim to each command line, word-split.
POLIGN_EXTRA_ARGS=
RECALL_EXTRA_ARGS=
