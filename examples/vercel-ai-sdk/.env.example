# Where `recall serve` listens. The app posts MCP requests to $RECALL_URL/mcp.
RECALL_URL=http://127.0.0.1:8080
# A Recall key. Its namespace is the memory this deployment reads and writes.
RECALL_API_KEY=rcl_dev_example_key
# Local runs only: an AI Gateway key from the Vercel dashboard (AI Gateway,
# API keys). A deployment on Vercel authenticates as itself and needs none.
AI_GATEWAY_API_KEY=
